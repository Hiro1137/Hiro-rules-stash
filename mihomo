name: Mihomo 分流规则转换版
desc: 各分类直接提供 DIRECT 与独立全节点选择器，避免 include-all 忽略显式选项。
# 使用 Stash 覆写语法；需搭配包含代理节点的主配置文件。
# 注意：proxy-groups、rule-providers、rules 使用 #!replace，会替换主配置原有项。

# ==========================================
# DNS：国内 App 使用 Real-IP，其余沿用 Fake-IP
# ==========================================
dns:
  fake-ip-filter: #!append
    # Bilibili
    - "+.bilibili.com"
    - "+.biliapi.net"
    - "+.bilivideo.com"
    - "+.biliimg.com"
    - "+.bilicdn1.com"
    - "+.hdslb.com"

    # Taobao / Tmall
    - "+.taobao.com"
    - "+.tmall.com"
    - "+.alicdn.com"
    - "+.tbcdn.cn"
    - "+.taobaocdn.com"

    # JD / 京东
    - "+.jd.com"
    - "+.360buyimg.com"
    - "+.360buy.com"
    - "+.jdcdn.com"
    - "+.jingdong.com"
    - "+.3.cn"

# ==========================================
# 代理策略组
# ==========================================
proxy-groups: #!replace
  # 默认代理可选择全部订阅节点
  - name: "🚀 默认代理"
    type: select
    include-all: true

  - name: "🔀 📹 YouTube 节点"
    type: select
    include-all: true

